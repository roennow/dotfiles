function ssh_docker() {
  local server=$1
  local container=$2
  shift 2
  local command="$@"

  if [[ -z "$server" || -z "$container" || -z "$command" ]]; then
    echo "Usage: ssh_docker <server> <container> <command>"
    return 1
  fi

  local escaped_command
  escaped_command=$(printf '%q ' "$@")

  echo $command
  ssh "$server" "docker exec $container $escaped_command"
}

now_playing() {
    if osascript -e 'application "Music" is running' | grep -q true; then
        song=$(osascript -e 'tell application "Music" to if player state is playing then artist of current track & " - " & name of current track')
        if [[ -n "$song" ]]; then
            echo $song
            return
        fi
    fi

    if osascript -e 'application "Spotify" is running' | grep -q true; then
        song=$(osascript -e 'tell application "Spotify" to if player state is playing then artist of current track & " - " & name of current track')
        if [[ -n "$song" ]]; then
            echo $song
            return
        fi
    fi

    return false
}
get_vcs_info() {
    vcs_info
    if [[ -n "$vcs_info_msg_0_" ]]; then
        # Check for untracked files (not included in default vcs_info)
        local untracked=""
        if [[ -n $(git ls-files --others --exclude-standard 2>/dev/null) ]]; then
            untracked=" ?"
        fi
        
        # Check for ahead/behind status
        local ahead_behind=""
        if git rev-parse @{upstream} &>/dev/null; then
            local ahead=$(git rev-list --count @{upstream}..HEAD 2>/dev/null)
            local behind=$(git rev-list --count HEAD..@{upstream} 2>/dev/null)
            [[ $ahead -gt 0 ]] && ahead_behind+=" ↑$ahead"
            [[ $behind -gt 0 ]] && ahead_behind+=" ↓$behind"
        fi
        
        echo "$vcs_info_msg_0_$untracked$ahead_behind"
        return 0
    fi
    echo ""
    return 1
}
function transfer_and_rename {
    # Check if the correct number of arguments is provided
    if [ "$#" -ne 2 ]; then
        echo "Usage: transfer_and_rename [--m|--s] <file_path>"
        return 1
    fi

    local option=""
    local file_path=""

    # Parse the arguments
    for arg in "$@"; do
        case "$arg" in
            -m|-s)
                option="$arg"
                ;;
            *)
                file_path="$arg"
                ;;
        esac
    done

    local server="root@serber"  # Replace with your actual server user and address
    local remote_base_path="/mnt/user/appdata/Kometa/assets"  # Replace with your actual remote base path

    # Prompt for Movies or Series
    echo "Would you like to save this file to Movies or Series? (Enter m for Movies or s for Series)"
    read option

    # Determine the subfolder based on the option
    case "$option" in
        m|M) 
            remote_base_path="${remote_base_path}/Movies"
            ;;
        s|S)
            remote_base_path="${remote_base_path}/Series"
            ;;
        *)
            echo "Invalid option. Use m for Movies or s for Series."
            return 1
            ;;
    esac

    local filename=$(basename "$file_path")
    local filetype="${filename##*.}"
    local basename="${filename%.*}"
    local remote_folder="${remote_base_path}/${basename}"
    local remote_file="${remote_folder}/poster.${filetype}"

    # Create the folder on the server
    ssh "$server" "mkdir -p '${remote_folder}'"

    # Transfer the file to the server and rename it
    scp "$file_path" "${server}:${remote_file}"

    echo "File transferred and renamed to ${remote_file} on the server."
}


