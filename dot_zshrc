# History
HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

autoload -Uz vcs_info

# Key bindings
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# Functions
pj() {
  local dir="${1:-$PWD}"
  phpstorm "$dir"
}

function ssh_docker() {
  local server=$1
  local container=$2
  shift 2
  local command="$@"

  if [[ -z "$server" || -z "$container" || -z "$command" ]]; then
    echo "Usage: ssh_docker <server> <container> <command>"
    return 1
  fi

  local escaped_command
  escaped_command=$(printf '%q ' "$@")

  echo $command
  ssh "$server" "docker exec $container $escaped_command"
}

